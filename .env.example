# Optional key for creating the first administrator. Empty skips the key field/check.
# To require a key, put a long, unique value in .env (ignored by git).
SETUP_TOKEN=

# NAS HTTP port. Use a reverse proxy and HTTPS for access outside your LAN.
HOST_PORT=8080

# Optional absolute NAS host directory mapped to /data inside the container.
# Leave empty to keep the existing Docker named volume (navigation-data).
# Create the directory first and grant UID/GID 10001 write access.
# Example: DATA_DIR=/volume1/docker/harbor-navigation/data
DATA_DIR=

# Only true when requests always pass through a trusted reverse proxy that sets X-Forwarded-Proto.
TRUST_PROXY=false
# Comma-separated CIDRs of the actual reverse-proxy peers. Empty trusts loopback only.
# For Docker/NAS, specify the proxy IP/subnet as seen by the application, e.g. 172.20.0.2/32.
TRUSTED_PROXY_CIDRS=

# Public GitHub repository and GHCR image used by the update checker and updater.
# Check updates uses public GitHub Releases + update.json; installations need a published image.
UPDATE_REPOSITORY=Qiangii/QiangMacNav
UPDATE_IMAGE=ghcr.io/qiangii/qiangmacnav
# Use a published image instead of the default local build when desired.
# Set only after the first image is published:
# NAVIGATION_IMAGE=ghcr.io/qiangii/qiangmacnav:latest
# Online updates also require compose.updates.yaml and a private random token.
UPDATER_TOKEN=

# For a source build, match server/internal/buildinfo/version.txt.
# APP_VERSION=1.0.5

# Optional Go module mirror for constrained Docker build networks.
# GOPROXY=https://goproxy.cn,direct
